# SMO Configuration
# Copy this file to .env and set your actual values

# ============================================
# Application Settings
# ============================================
PUBLIC_BASE_URL=http://localhost:8023
APP_VERSION=0.1.0
# SQLite database location (optional, defaults to data/smoomo.db)
SMO_DB_PATH=data/smoomo.db

# Security guardrails, frozen at startup (REC-002): no runtime tool can change them.
# DRY_RUN=true writes outbound payloads to data/dryrun instead of publishing.
DRY_RUN=true
# HUMAN_GATE=true requires an explicit approval before any publication.
HUMAN_GATE=true

# Dashboard token: required to approve/reject drafts from the web UI.
# Leave empty to disable dashboard approvals (CLI and MCP keep working).
SMO_DASHBOARD_TOKEN=

# ============================================
# LLM Providers
# ============================================
LLM_DEFAULT=ollama/llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Image generation (FR-08). Paid: each image is counted against BUDGET_PER_DAY_USD.
# IMAGE_PROVIDER=openai
# IMAGE_MODEL=gpt-image-2        # DALL·E models are retired; gpt-image-1 was shut down on 2026-10-23
# Quality low = about $0.006 per 1024x1024 image, medium about $0.053, high about $0.211 (estimates).
# An agent can also supply its own image: attach_image(content_id, path=...) reads data/inputs/.

# ============================================
# Security Budgets
# ============================================
BUDGET_PER_DAY_USD=1.5

# ============================================
# Brand Voice (Mutable)
# ============================================
BRAND_VOICE_TONE=professional, concise, occasionally witty
BRAND_VOICE_EMOJIS=false
BRAND_VOICE_BANNED_TOPICS=["politics", "religion"]

# ============================================
# MCP Settings
# ============================================
MCP_ENABLED=true
MCP_TRANSPORT=["stdio", "http"]
MCP_HTTP_REQUIRES_KEY=true

# ============================================
# Platform Accounts (Configuration)
# ============================================
# Per-platform defaults, as JSON (pydantic-settings parses dict fields from JSON).
# "scheduling" is used by 'smo schedule' and schedule_post when no strategy/timezone
# is given, so each platform (and its accounts) can use its own defaults.
ACCOUNTS={"linkedin": {"enabled": true, "scheduling": {"strategy": "weighted_by_engagement", "timezone": "Europe/Paris"}}, "wordpress": {"enabled": true}}

# WordPress
ACCOUNTS_WORDPRESS_SITE=https://blog.example.com

# Privacy
COMMENT_ACCESS=false

# ============================================
# OAuth Tokens (Placeholder - set via smo auth)
# ============================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Versioned-API header for image uploads (YYYYMM). LinkedIn keeps a version for at least a year.
LINKEDIN_API_VERSION=202601
# X (Twitter): off by default, paid API tiers apply. Callback URL must be registered in the X app.
X_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional: defaults to <PUBLIC_BASE_URL>/oauth/x/callback
X_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORDPRESS_APP_USERNAME=
WORDPRESS_APP_PASSWORD=

# ============================================
# MCP Agent Keys (One per agent)
# ============================================
# The name after MCP_API_KEY_ selects the scopes:
#   HERMES -> read, content
#   ADMIN  -> read, content, control, admin
#   other  -> read only
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Hermes agent key (content operations)
MCP_API_KEY_HERMES=

# Admin agent key (control + admin)
MCP_API_KEY_ADMIN=

# stdio clients (smo mcp) take their key from the client configuration, not from this file:
#   SMO_MCP_API_KEY=<one of the keys above>
# HTTP clients send it as: Authorization: Bearer <key>. See docs/MCP.md.

# ============================================
# Secrets (Security - Never commit real values)
# ============================================
# Option 1: Set SMO_MASTER_KEY in environment
# Option 2: Use SMO_MASTER_KEY_PATH to point to a file

# If using SMO_MASTER_KEY environment variable:
SMO_MASTER_KEY=

# If using key file (recommended for NAS):
SMO_MASTER_KEY_PATH=/app/secrets/smomo_master_key
