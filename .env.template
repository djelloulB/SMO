# SMO Configuration Template
# Copy this file to .env and set your actual values

# Application
PUBLIC_BASE_URL=http://localhost:8023
APP_VERSION=0.1.0

# LLM Providers
LLM_DEFAULT=ollama/llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Budget
BUDGET_PER_DAY_USD=1.5

# Brand Voice (mutable)
BRAND_VOICE_TONE=professional, concise, occasionally witty
BRAND_VOICE_EMOJIS=false
BRAND_VOICE_BANNED_TOPICS=["politics", "religion"]

# MCP
MCP_ENABLED=true
MCP_TRANSPORT=["stdio", "http"]
MCP_HTTP_REQUIRES_KEY=true

# Platform Accounts (configuration)
ACCOUNTS_LINKEDIN_ENABLED=true
ACCOUNTS_LINKEDIN_SCHEDULING_STRATEGY=weighted_by_engagement
ACCOUNTS_LINKEDIN_TIMEZONE=Europe/Paris

ACCOUNTS_WORDPRESS_ENABLED=true
ACCOUNTS_WORDPRESS_SITE=https://blog.example.com

# Privacy
COMMENT_ACCESS=false

# OAuth tokens (placeholder - set via smo auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORDPRESS_APP_USERNAME=
WORDPRESS_APP_PASSWORD=

# MCP Agent Keys (one per agent)
MCP_API_KEY_HERMES=
MCP_API_KEY_ADMIN=
